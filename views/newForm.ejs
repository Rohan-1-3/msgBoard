<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message Form</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <%- include('header')%>
    <div class="form-container">
        <form action="/new" method="POST">
            <div>
                <label for="user">Your Name:</label>
                <input type="text" name="user" id="user" required placeholder="Enter your name" autocomplete="off">
            </div>
            <div>
                <label for="text">Message:</label>
                <input type="text" name="text" id="text" required placeholder="Enter your message" autocomplete="off">
            </div>
            <button type="submit">Submit</button>
        </form>

        <a href="/">
            <button class="back-button">Go Back</button>
        </a>
    </div>
    <%- include('footer')%>
</body>
</html>