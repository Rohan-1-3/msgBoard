<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
    <% if(message){ %>
        <h1><%= message.text %></h1>
        <h3><%= message.user%> <%= message.added %></h3>
    <% }else{%>
        <h1>Sorry. No Such Message.</h1>
    <% }%>
    <a href="/"><button>Go back</button></a>
    <%- include('footer')%>
</body>
</html>